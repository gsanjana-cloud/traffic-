# AI-Based Automated Traffic Signal Control System
# Backend Environment Configuration

PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Computer Vision / YOLO Configuration
YOLO_MODEL_NAME=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.40
FORCE_DEMO_MODE=false

# Signal Timing Defaults (Seconds)
MIN_GREEN_SEC=10.0
MAX_GREEN_SEC=60.0
AMBER_SEC=3.0
ALL_RED_SEC=1.0
STARVATION_THRESHOLD_SEC=60.0
FIXED_TIME_GREEN_SEC=25.0

# Multi-Factor Scoring Default Weights (Sum = 1.0)
WEIGHT_VEHICLE_COUNT=0.35
WEIGHT_QUEUE_LENGTH=0.20
WEIGHT_WAITING_TIME=0.30
WEIGHT_VEHICLE_TYPE=0.15

# SQLite Database Location
DATABASE_PATH=backend/data/traffic_system.db
